# ========================================================
# Portfolio Contact Form Backend — Environment Variables
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
# For local development: http://localhost:5173
# For production: https://prateek-mohanty.vercel.app
FRONTEND_URL=http://localhost:5173,https://prateek-mohanty.vercel.app

# Resend Email Delivery API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Testing Sender Identity (Use onboarding@resend.dev during testing)
RESEND_SENDER=Portfolio Contact <onboarding@resend.dev>

# Contact Form Destination
# All incoming portfolio contact messages will be securely delivered to this recipient:
CONTACT_RECEIVER=prateekmohanty2006@gmail.com
