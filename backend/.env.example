# ========================================================
# Portfolio Contact Form Backend — Environment Variables
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
# For local development: http://localhost:5173
# For production: https://prateek-mohanty.vercel.app
FRONTEND_URL=http://localhost:5173,https://prateek-mohanty.vercel.app

# Gmail SMTP Configuration
# Use smtp.gmail.com with SSL (port 465) or TLS (port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# SMTP Authentication (Dedicated Gmail account & Google App Password)
# IMPORTANT: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your-automation-email@gmail.com
SMTP_APP_PASSWORD=your-google-app-password

# Contact Form Destination
# All incoming portfolio contact messages will be securely delivered to this private inbox:
CONTACT_RECEIVER=mohantyprateek777@gmail.com

